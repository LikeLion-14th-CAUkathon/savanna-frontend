{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://savannaexpedition.duckdns.org/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://savannaexpedition.duckdns.org/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://savannaexpedition.duckdns.org/login/oauth2/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
